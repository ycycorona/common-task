# ~/.oci/config 模板：复制到 ~/.oci/config（chmod 600），填真实值。
# 私钥放 ~/.oci/keys/oci_api_key.pem（chmod 600），不入 Git。
# 加一个只读 profile 时复制整段改名，例如 [READONLY]。

[DEFAULT]
user=ocid1.user.oc1..<user-ocid>
fingerprint=<api-key-fingerprint>
tenancy=ocid1.tenancy.oc1..<tenancy-ocid>
region=eu-amsterdam-1
key_file=~/.oci/keys/oci_api_key.pem
