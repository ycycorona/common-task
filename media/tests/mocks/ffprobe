#!/usr/bin/env python3
import sys
import os

def main():
    # 检查是否是 codec_name 查询（有 nokey=1）
    has_nokey = any('nokey=1' in arg for arg in sys.argv)
    
    if has_nokey:
        print(os.environ.get('TEST_FFPROBE_CODEC', 'aac'))
    else:
        # audio streams 查询
        print("index=0")
        print("codec_name=aac")
        print("channels=1")
        print("sample_rate=48000")
    
    sys.exit(0)

if __name__ == '__main__':
    main()
