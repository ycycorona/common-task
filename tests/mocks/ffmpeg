#!/usr/bin/env python3
import sys
import shutil
import os

def main():
    # 找到 -i 后面的输入文件
    input_file = None
    i = 1
    while i < len(sys.argv):
        if sys.argv[i] == '-i' and i + 1 < len(sys.argv):
            input_file = sys.argv[i + 1]
            i += 2
        else:
            i += 1
    
    # 输出文件是最后一个参数（通常是输出路径）
    output_file = sys.argv[-1] if len(sys.argv) > 1 and not sys.argv[-1].startswith('-') else None
    
    if input_file and output_file and os.path.exists(input_file):
        shutil.copy(input_file, output_file)
    
    # 检查是否应该模拟失败
    fail_env = os.environ.get('TEST_FFMPEG_FAIL', '')
    if fail_env and input_file and fail_env in input_file:
        print(f"Mock ffmpeg: simulated failure for {input_file}", file=sys.stderr)
        sys.exit(1)
    
    sys.exit(0)

if __name__ == '__main__':
    main()
